		(property "Datasheet" "https://www.richtek.com/Products/Linear%20Regulator/Single%20Output%20Linear%20Regulator/RT9013?sc_lang=zh-CN"
			(at 87.63 53.34 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Description" "RT9013 是一款高性能、输出电流能力 500mA 的线性稳压器，提供极高的 PSRR 和 超低压降。此产品非常符合可携式 RF 和无线应用的效能和大小需求。静态电流可低至 25μA，来延长电池的使用寿命。RT9013 也适用低 ESR 的陶瓷电容，从而减少于手持无线装置上所需的电路板空间。在 shutdown 模式下消耗 0.7μA (典型值)，并且有很快的开机时间 (少于 40μs)。其它特性包括超低压差电压、高输出精确度、限流保护和高 PSRR。RT9013 提供 SC-82, SOT-23-5, SC-70-5 和 WDFN-6L 2x2 封装。"
			(at 87.63 53.34 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
